<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.label.admin.mapper.SysFileMapper">

    <resultMap id="FileWithUploaderMap" type="com.label.admin.entity.SysFile">
        <id column="id" property="id"/>
        <result column="original_name" property="originalName"/>
        <result column="stored_name" property="storedName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="uploader_id" property="uploaderId"/>
        <result column="created_at" property="createdAt"/>
        <result column="uploader_name" property="uploaderName"/>
    </resultMap>

    <select id="selectFilePage" resultMap="FileWithUploaderMap">
        SELECT f.*, u.nickname as uploader_name
        FROM sys_file f
        LEFT JOIN sys_user u ON f.uploader_id = u.id
        <where>
            <if test="originalName != null and originalName != ''">
                AND f.original_name LIKE CONCAT('%', #{originalName}, '%')
            </if>
            <if test="uploaderId != null">
                AND f.uploader_id = #{uploaderId}
            </if>
        </where>
        ORDER BY f.created_at DESC
    </select>
</mapper>
